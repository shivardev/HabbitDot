{
  "name": "habbitdot",
  "version": "1.0.1",
  "description": "A private, offline-first habit tracker with smart reminders and detailed analytics.",
  "license": "MIT",
  "keywords": [
    "expo",
    "react-native",
    "habit-tracker",
    "offline-first",
    "notifications",
    "analytics"
  ],
  "main": "index.ts",
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.14",
    "expo-notifications": "~57.0.13",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo-doctor": "1.20.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && expo-doctor"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true
